# Copy to backend/.env for local development. Every value shown is the default.

# postgres:// and postgresql:// URLs are also accepted (rewritten to use psycopg 3).
DATABASE_URL=postgresql+psycopg://sentiment:sentiment@localhost:5432/sentiment
REDIS_URL=redis://localhost:6379/0
# Default: <repo>/artifacts/models/tfidf-logreg-1.0.0 (the Docker image sets its own path).
# MODEL_DIR=../artifacts/models/tfidf-logreg-1.0.0

CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400

MAX_TEXT_LENGTH=1000
BATCH_MAX_ROWS=500
BATCH_MAX_BYTES=1000000
# Predictions with confidence below this are flagged is_low_confidence=true.
LOW_CONFIDENCE_THRESHOLD=0.55

LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
APP_VERSION=1.0.0
ENVIRONMENT=development
