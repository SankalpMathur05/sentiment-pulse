# Copy to .env to override the defaults used by docker-compose.yml.
# .env is git-ignored: never commit real passwords.

# --- PostgreSQL ---
# PostgreSQL applies the password only when its data volume is first created. If you change
# it after the first start, recreate the volume: docker compose down -v (deletes stored data).
POSTGRES_USER=sentiment
POSTGRES_PASSWORD=sentiment
POSTGRES_DB=sentiment

# --- API ---
CACHE_ENABLED=true
# Seconds a cached prediction stays in Redis (default: 1 day).
CACHE_TTL_SECONDS=86400
# Longest accepted post, in characters.
MAX_TEXT_LENGTH=1000
# CSV batch limits.
BATCH_MAX_ROWS=500
BATCH_MAX_BYTES=1000000
# Predictions below this confidence are flagged "low confidence" in the UI.
LOW_CONFIDENCE_THRESHOLD=0.55
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API directly from a browser.
CORS_ORIGINS=http://localhost:3000

# --- Running the API outside Docker: see backend/.env.example (localhost URLs) ---
